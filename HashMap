\section{经典例题}
\subsection{1. 无重复字符的最长子串（查重）}
用 \texttt{unordered\_set} + 双指针：
\begin{lstlisting}
class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        unordered_set<char> letter;
        int n = s.size();
        int ans = 0;
        int left = 0;
        
        for (int right = 0; right < n; right++) {
            while (letter.find(s[right]) != letter.end()) {
                letter.erase(s[left]);
                left++;
            }
            letter.insert(s[right]);
            ans = max(ans, right - left + 1);
        }
        return ans;
    }
};
\end{lstlisting}

\subsection{2. 单词规律（双射）}
双向映射：字符↔单词：
\begin{lstlisting}
class Solution {
public:
    bool wordPattern(string pattern, string s) {
        unordered_map<char, string> c2w;
        unordered_map<string, char> w2c;
        istringstream iss(s);
        vector<string> words;
        string word;
        
        while (iss >> word) words.push_back(word);
        if (pattern.size() != words.size()) return false;
        
        for (int i = 0; i < pattern.size(); i++) {
            char c = pattern[i];
            string w = words[i];
            
            if (c2w.count(c) && c2w[c] != w) return false;
            if (w2c.count(w) && w2c[w] != c) return false;
            
            c2w[c] = w;
            w2c[w] = c;
        }
        return true;
    }
};
\end{lstlisting}

\subsection{3. 数组交集 II（计数）}
用 \texttt{unordered\_map} 统计次数：
\begin{lstlisting}
class Solution {
public:
    vector<int> intersect(vector<int>& nums1, vector<int>& nums2) {
        if (nums1.size() > nums2.size())
            return intersect(nums2, nums1);
        
        unordered_map<int, int> cnt;
        for (int x : nums1) cnt[x]++;
        
        vector<int> ans;
        for (int x : nums2) {
            if (cnt[x] > 0) {
                ans.push_back(x);
                cnt[x]--;
            }
        }
        return ans;
    }
};
\end{lstlisting}

\section{核心要点}
\begin{enumerate}
    \item 哈希表 = 关键字 → 下标映射，减少遍历
    \item \texttt{unordered\_map}：存键值对，适合映射
    \item \texttt{unordered\_set}：只存键，适合查重
    \item 冲突：线性探测 / 平方探测 / 拉链法
    \item 线性探测删除：用 \texttt{DEL} 标记，避免查找中断
\end{enumerate}

